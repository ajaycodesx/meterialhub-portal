# ==============================================================================
# MaterialHub Production Nginx Reverse Proxy Configuration Template
# Placeholders: api.materialhub.in, /etc/letsencrypt/live/api.materialhub.in/
# ==============================================================================

# Rate limiting zone at reverse proxy level (first defense line)
limit_req_zone $binary_remote_addr zone=api_general:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=api_auth:10m rate=5r/s;

# Upstream FastAPI application cluster
upstream materialhub_backend {
    server 127.0.0.1:8000;
    keepalive 32;
}

# 1. HTTP to HTTPS Strict Redirection
server {
    listen 80;
    listen [::]:80;
    server_name api.materialhub.in;

    # ACME Challenge for Let's Encrypt / Certbot renewal
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 2. HTTPS SSL Termination
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.materialhub.in;

    # SSL Certificate Paths (Let's Encrypt Certbot)
    ssl_certificate /etc/letsencrypt/live/api.materialhub.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.materialhub.in/privkey.pem;

    # Mozilla Modern SSL Protocol & Ciphers
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # OCSP Stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    # Security Headers
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Uploads (BOQ PDF / Excel files)
    client_max_body_size 50M;

    # Auth endpoints rate limiting at proxy tier
    location /api/v1/auth/ {
        limit_req zone=api_auth burst=10 nodelay;

        proxy_pass http://materialhub_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    # API Proxy
    location / {
        limit_req zone=api_general burst=50 nodelay;

        proxy_pass http://materialhub_backend;
        proxy_http_version 1.1;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Standard Proxy Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
