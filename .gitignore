# ==============================================================================
# MaterialHub Master Git Ignore Rules
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output & Cache
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/
.turbo/
**/.turbo/

# Testing & Coverage
coverage/
**/coverage/
.nyc_output/

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local Environment Variables & Secrets
.env
.env.*
**/.env
**/.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key
*.cert

# Databases & Backups
*.db
**/*.db
*.sqlite
**/*.sqlite
*.sqlite3
**/*.sqlite3
*.dump
*.sql.gz
backups/
**/backups/

# Python & Testing Cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.venv/
**/.venv/
env/
venv/

# Vercel / Deployment Cache
.vercel/
**/.vercel/

# TypeScript Build Cache
*.tsbuildinfo

# OS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Code Editors
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Temp Files & Cache
.cache/
**/.cache/
tmp/
**/tmp/
.temp/
